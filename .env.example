APP_NAME="TaskPriority"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# REASONING UKK: Konfigurasi SQLite file tunggal agar aplikasi 100% mandiri dan siap demo offline tanpa instalasi MySQL/XAMPP
DB_CONNECTION=sqlite
# DB_DATABASE tidak perlu diisi path absolut jika menggunakan database/database.sqlite standar Laravel 11/10
# atau isi: database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

